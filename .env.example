# ==============================================================================
# DEVPLUX FINANCIAL MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE
# Copy this file to .env.local and populate with your project credentials.
# NEVER COMMIT REAL PRODUCTION SECRETS OR SERVICE KEYS TO GITHUB!
# ==============================================================================

# Supabase Public API Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Administrative Service Key (Server-side ONLY — Never expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Corporate Branding & Governance
NEXT_PUBLIC_COMPANY_NAME=Devplux (Pvt) Ltd
NEXT_PUBLIC_COMPANY_REG_NO=PV-00289144
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR

# Optional: Initial Setup Credentials for scripts/seed.mjs
# If left empty, seed.mjs will securely generate random one-time setup passwords
# DIRECTOR_1_INITIAL_PASSWORD=
# DIRECTOR_2_INITIAL_PASSWORD=
# DIRECTOR_3_INITIAL_PASSWORD=
# DIRECTOR_4_INITIAL_PASSWORD=
# DIRECTOR_5_INITIAL_PASSWORD=

